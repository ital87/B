int main() {
    char a = 'A';
    char space = ' ';
    char newline = '\n';
    char tab = '\t';
    char quote = '\'';
    char backslash = '\\';

    printf("Char: %c\n", a);
    printf("ASCII: %d\n", a);

    if (a == 'A') {
        println("It's A!");
    }

    string s = "Hello";
    char c = 'H';
    if (s[0] == c) {
        println("First char matches!");
    }

    return 0;
}

