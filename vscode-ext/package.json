{
  "name": "b-language",
  "displayName": "B Language Support",
  "description": "Syntax highlighting and language support for the B programming language",
  "version": "0.2.0",
  "publisher": "ital87",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "b",
        "aliases": [
          "B",
          "b"
        ],
        "extensions": [
          ".b"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "b",
        "scopeName": "source.b",
        "path": "./syntaxes/b.tmLanguage.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ital87/B.git"
  },
  "keywords": [
    "b",
    "systems",
    "language",
    "compiled",
    "llvm",
    "ownership"
  ]
}
