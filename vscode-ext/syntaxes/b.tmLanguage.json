{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "B",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.b",
          "match": "//.*$"
        },
        {
          "name": "comment.block.b",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "comment.block.b"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.type.b",
          "match": "\\b(int|float|double|bool|char|string|void|own|mut)\\b"
        },
        {
          "name": "keyword.control.b",
          "match": "\\b(if|else|for|while|return|switch|case|default|break|continue|some)\\b"
        },
        {
          "name": "keyword.declaration.b",
          "match": "\\b(struct|enum|fn|typedef|const|namespace|drop)\\b"
        },
        {
          "name": "keyword.control.import.b",
          "match": "\\b(import|using|pub)\\b"
        },
        {
          "name": "keyword.operator.sizeof.b",
          "match": "\\b(sizeof|new|len)\\b"
        },
        {
          "name": "keyword.constant.b",
          "match": "\\b(true|false|none)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.b",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.b",
              "match": "\\\\[\\\\\"'ntrb]"
            }
          ]
        },
        {
          "name": "string.quoted.single.b",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.b",
              "match": "\\\\[\\\\\"'ntrb]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.b",
          "match": "\\b([0-9]+\\.[0-9]+)\\b"
        },
        {
          "name": "constant.numeric.integer.b",
          "match": "\\b([0-9]+)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.separator.namespace.b",
          "match": "(::)"
        },
        {
          "name": "keyword.operator.comparison.b",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.b",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.b",
          "match": "(&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.arithmetic.b",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.b",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.arrow.b",
          "match": "(->)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.parameters.b",
          "match": "[()\\[\\]{}]"
        },
        {
          "name": "punctuation.terminator.b",
          "match": "[;,]"
        },
        {
          "name": "punctuation.separator.b",
          "match": "(:|\\.)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.b",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.b"
}
