{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Arc",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.arc",
          "match": "//.*$"
        },
        {
          "name": "comment.block.arc",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "comment.block.arc"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.type.arc",
          "match": "\\b(int|float|double|bool|void)\\b"
        },
        {
          "name": "keyword.control.arc",
          "match": "\\b(if|else|for|while|return)\\b"
        },
        {
          "name": "keyword.declaration.arc",
          "match": "\\b(struct|enum|fn)\\b"
        },
        {
          "name": "keyword.constant.arc",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.arc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.arc",
              "match": "\\\\[\\\\\"'ntrb]"
            }
          ]
        },
        {
          "name": "string.quoted.single.arc",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.arc",
              "match": "\\\\[\\\\\"'ntrb]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.arc",
          "match": "\\b([0-9]+\\.[0-9]+)\\b"
        },
        {
          "name": "constant.numeric.integer.arc",
          "match": "\\b([0-9]+)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.arc",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.arc",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.arc",
          "match": "(&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.arithmetic.arc",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.arc",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.arrow.arc",
          "match": "(->)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.parameters.arc",
          "match": "[()\\[\\]{}]"
        },
        {
          "name": "punctuation.terminator.arc",
          "match": "[;,]"
        },
        {
          "name": "punctuation.separator.arc",
          "match": "(:|\\.)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.arc",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.arc"
}

